# =============================================================================
# schat.ai (Sunway fork of Open WebUI) — environment template
#
# Copy to `.env` and fill in the secrets. Two things to know before you edit:
#
# 1. IF YOU USE `dev.ps1`, IT OVERRIDES MOST OF THIS.
#    `dev.ps1` loads `.env` (Import-DotEnv, ~line 118) and THEN hardcodes ~40
#    `$env:` vars (lines 152-318). Later assignment wins, so for any var
#    `dev.ps1` sets, editing it here has NO effect. Change it in `dev.ps1`.
#    Vars below marked [dev.ps1 wins] are in that set.
#
# 2. IF YOU DO NOT USE `dev.ps1` (npm run build + backend/start.sh, uvicorn
#    directly, CI/CD, a non-Windows box), THIS FILE IS YOUR ONLY BASELINE.
#    The code defaults are upstream Open WebUI's, NOT schat's — so without the
#    Sunway section below you get a subtly different app: upstream branding,
#    deferred features visible, image-for-non-vision-model handling off.
#
# 3. [PersistentConfig] vars seed the DB on FIRST BOOT ONLY. On an existing DB
#    the env var is ignored — change those in Admin Settings instead.
# =============================================================================

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Image vision LLM (Sunway): endpoint + key for the vision model that reads uploaded
# images for text-only chat models. BASE_URL *and* _MODEL must both be set for the vision
# path to activate — _MODEL lives in the Sunway section at the bottom of this file.
# Keep the key in .env only — never in dev.ps1, which is committed (ISO 27001: no
# committed creds).
RAG_IMAGE_VISION_LLM_BASE_URL=''
RAG_IMAGE_VISION_LLM_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# Sunway: NEVER set this to '*'. main.py adds CORSMiddleware with
# allow_credentials=True, and Starlette's CORSMiddleware.send() special-cases that
# combination: with allow_all_origins AND allow_credentials it ECHOES the requesting
# Origin back and sends Access-Control-Allow-Credentials: true. Any website could then
# make credentialed cross-origin calls to the API and read the responses, and any
# origin-based CSRF defence is gone. (Security review finding C3.)
#
# The deployment chart pins the real origin in every environment, so this file is the
# only place the wildcard survived — and it is the file people copy when standing up a
# new environment or a local Docker run. Explicit dev origins below.
CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'


# =============================================================================
# SUNWAY / schat BASELINE
#
# As of 2026-07-31 the schat product decisions below are CODE DEFAULTS in
# env.py / config.py — voice, temporary chat, archive, the deferred features,
# the 30-chat cap and 30-day retention all apply with NO env set at all. You
# no longer have to remember them per environment; they are listed here as
# documented OVERRIDES (e.g. to re-enable a feature for a pilot).
#
# Two exceptions that still need action per environment:
#   - [PersistentConfig] vars seed a FRESH DB only. Staging/prod already have
#     DBs, so those must be flipped in Admin Settings regardless of the default.
#   - Environment FACTS (endpoints, credentials, hardware tuning) are still
#     required — they cannot have a sensible code default. See the sections
#     above and RAG_IMAGE_VISION_LLM_MODEL below.
#
# `dev.ps1` still sets most of this explicitly [dev.ps1 wins] but now yields to
# whatever you put in .env. Prod does NOT read this file: the Helm manifest
# supplies these. See sunway-schat-notes.md §2.
# =============================================================================

# -- Branding assets ----------------------------------------------------------
# NOTHING TO SET (since 2026-07-31). `/static/*` is served from STATIC_DIR, which
# defaults to backend/open_webui/static — the /static mount is registered before the
# SPA mount, so it wins even for a built frontend. sync-brand.ps1 now vendors the
# brand assets into that directory as well, so the correct branding is served with no
# env var, under dev.ps1, start.sh, dev.sh and the container alike.
# (Re-run sync-brand.ps1 after any brand-repo update, and COMMIT the result — the
# container image gets these from the repo.)
# Only set this to serve /static from somewhere else entirely:
# STATIC_DIR='/absolute/path/to/repo/static'

# -- Catalogue handoff (SCore.ai) ----------------------------------------------
# Public URL of the catalogue (SCore.ai) this app is listed in. When set, an
# anonymous visitor to /auth is bounced there instead of shown schat's own
# sign-in page — see the comments in routes/auth/+page.svelte and
# routes/no-access/+page.svelte for the full handoff logic. Leave unset for a
# fully standalone local instance (no bounce, schat's own sign-in page shows).
# Staging/production set this via the Helm chart; NOT read from this file there.
# LANDING_PAGE_URL='https://landing-staging.mymswgl-ai-application.sunway.com'

# -- Image understanding for text-only models ---------------------------------
# Three knobs, three different authorities — see the table in
# sunway-schat-notes.md §2 before changing any of them.
#
# Vision model id. BASE_URL (top of file) + this MUST BOTH be set or the vision
# path silently no-ops and images fall through to plain extraction.
RAG_IMAGE_VISION_LLM_MODEL='google/gemma-4-E4B-it'
# Gemma-alone is now the code default. Uncomment to ALSO run Docling OCR and merge it
# (slower, and hard-depends on Docling being reachable).
# RAG_IMAGE_VISION_LLM_COMBINE_OCR='true'
# NOTE: images are only admitted to the extraction pipeline at all when
# CONTENT_EXTRACTION_ENGINE is OCR-capable (docling / datalab_marker /
# document_intelligence / mistral_ocr) — see routers/files.py. That engine is
# [PersistentConfig], so on an existing DB set it in Admin Settings → Documents.
# Without it, image uploads fail with "File type image/png is not supported for
# processing" no matter what the two vars above say.

# -- Deferred / hidden features (see the table in CLAUDE.md) ------------------
# NOTHING TO SET — all of these now default to false in code (env.py / config.py).
# Listed here only so you know the override exists, e.g. to pilot one feature.
# Uncomment a line ONLY to turn something back ON.
# ENABLE_VOICE='true'
# ENABLE_TEMPORARY_CHAT='true'
# ENABLE_CHAT_ARCHIVE='true'
# ENABLE_VERSION_UPDATE_CHECK='true'
#
# [PersistentConfig] — the code default seeds a FRESH DB only. An existing DB keeps
# whatever is already stored, so these must be changed in Admin Settings there; setting
# them here will do nothing on a DB that has already booted once.
# ENABLE_NOTES='true'
# ENABLE_MEMORIES='true'
# ENABLE_FOLDERS='true'
# ENABLE_CODE_INTERPRETER='true'
# ENABLE_CALENDAR='true'
# ENABLE_AUTOMATIONS='true'
# ENABLE_MESSAGE_RATING='true'
# USER_PERMISSIONS_SETTINGS_INTERFACE='true'

# -- Retention & caps ---------------------------------------------------------
# NOTHING TO SET — 30 chats / 30 days are the code defaults. Both were previously 0,
# which silently means "no cap" and "never expire"; override only to change the policy.
# MAX_CHATS_PER_USER='30'
# CHAT_RETENTION_DAYS='30'

# -- Extraction engine [PersistentConfig] -------------------------------------
# Seeds a fresh DB only. Existing DB → Admin Settings → Documents.
CONTENT_EXTRACTION_ENGINE='docling'
DOCLING_SERVER_URL='http://localhost:5001'
DOCLING_PARAMS='{"do_ocr": true, "ocr_engine": "easyocr", "ocr_lang": "en", "images_scale": 2, "table_mode": "fast"}'
DOCLING_ASYNC='true'

# -- Embedding + RAG [PersistentConfig] — SET THESE BEFORE FIRST BOOT ---------
# ⚠️ RAG_EMBEDDING_MODEL is the one that genuinely bites. It seeds a FRESH DB, and the
# upstream default is all-MiniLM (384 dims) vs bge-m3 (1024). Boot once without it and the
# database is committed to a different vector space: every KB built there is unusable
# against a corrected config, and fixing it means a full reindex. No error is raised.
RAG_EMBEDDING_MODEL='BAAI/bge-m3'
RAG_EMBEDDING_BATCH_SIZE='8'
# Chat attachments ≤ RAG_FULL_CONTEXT_MAX_CHARS are injected whole instead of embedded.
RAG_CHAT_ATTACHMENT_FULL_CONTEXT='true'
# ⚠️ Also PersistentConfig, also silent: unset on a fresh DB means the upload allowlist
# defaults to ALLOW-ALL. Pin it.
RAG_ALLOWED_FILE_EXTENSIONS='pdf,docx,xlsx,pptx,csv,txt,md,png,jpg,jpeg'
# Extraction A/B fast paths — OFF (Docling wins outright on GPU; see dev.ps1 for the A/B).
RAG_PDF_FAST_PATH='false'
RAG_PDF_FAST_PATH_ENGINE='pypdf'
RAG_OFFICE_FAST_PATH='false'
RAG_OFFICE_FAST_PATH_ENGINE='unstructured'

# Default model shown to a new user.
DEFAULT_MODELS='deepseek-ai/DeepSeek-V4-Flash'

# -- Local dev infra (docker-compose.dev.yml) ---------------------------------
# Only needed if you are not on dev.ps1 but ARE using the compose infra.
# Start it first:  docker compose -f docker-compose.dev.yml up -d
# ENABLE_WEB_SEARCH='true'
# WEB_SEARCH_ENGINE='searxng'
# SEARXNG_QUERY_URL='http://localhost:8888/search?q=<query>'
# STORAGE_PROVIDER='s3'
# S3_ENDPOINT_URL='http://localhost:9000'
# S3_ACCESS_KEY_ID='minioadmin'
# S3_SECRET_ACCESS_KEY='minioadmin'
# S3_BUCKET_NAME='open-webui'
# S3_REGION_NAME='us-east-1'
# REDIS_URL='redis://localhost:6379/0'
# ENABLE_WEBSOCKET_SUPPORT='true'
# WEBSOCKET_MANAGER='redis'
# WEBSOCKET_REDIS_URL='redis://localhost:6379/0'
# QDRANT_ON_DISK='true'

# -- DEV ONLY: TLS verification off for outbound calls ------------------------
# dev.ps1 sets these so the self-signed/internal certs on the AI-server
# endpoints don't block extraction. They disable verification for ALL outbound
# traffic (LiteLLM, OAuth, web search, Docling) — NEVER set them in prod, and
# only set them locally if you actually hit an SSLCertVerificationError.
# AIOHTTP_CLIENT_SESSION_SSL='false'
# REQUESTS_VERIFY='false'
# AIOHTTP_CLIENT_SESSION_TOOL_SERVER_SSL='false'   # same, for MCP tool servers (Sdeck)
